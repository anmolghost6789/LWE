# ==============================================================================
# Environment Configuration for learnwithexpert*
# ==============================================================================

# ------------------------------------------------------------------------------
# Email Notifications (Resend - https://resend.com)
# ------------------------------------------------------------------------------
# Free tier supports 3,000 emails/month. Add your key here or in your Vercel/Cloudflare project settings.
RESEND_API_KEY=re_your_resend_api_key_here

# The email address that receives inquiries submitted through the "Work With Us" form.
TEAM_NOTIFICATION_EMAIL=contact@learnwithexpert.com

# ------------------------------------------------------------------------------
# Optional Database Storage (Vercel / Cloudflare)
# ------------------------------------------------------------------------------
# In Cloudflare Workers, bind a D1 database named "DB" in wrangler.jsonc.
# In Vercel, submissions are persisted locally in data/contacts.json or via DATABASE_URL.
# DATABASE_URL=postgres://user:password@host:port/database

